# Copy to `.env.local` (same folder as this file). Vite only exposes vars prefixed with VITE_.
# `.env.local` is not committed — create it locally from this template.

# ── Stepped API base URL (API-000) ─────────────────────────────────────────
# Step 0 — Mock only (default): leave the next line empty or commented.
#          All services use `dataStore` / seeds; no HTTP calls.
#
# Step 1 — Local Express API (`npm run dev:server` on port 3001) behind Vite proxy:
#          `vite.config.ts` proxies `/api` → `http://localhost:3001`
#          Implements `/api/v1/auth/*`, `/api/v1/users/*`, `/api/bundle` (SQLite).
# VITE_API_BASE_URL=/api/v1
#
# Step 2 — API on another host (no proxy):
# VITE_API_BASE_URL=http://127.0.0.1:3001/api/v1
#
# Recommended with Step 1: also set VITE_USE_LOCAL_DB=true and run `npm run dev:full`
# so auth and app data both use the same SQLite bundle (single source of truth).

VITE_API_BASE_URL=

# Legacy alias (used if VITE_API_BASE_URL is empty)
VITE_LOCAL_API_BASE=

# When true, load/save app data via local SQLite API (`npm run dev:server` or `npm run dev:full`).
# `npm run dev` alone keeps browser localStorage (no server required).
VITE_USE_LOCAL_DB=false

# ── Supabase (optional) — pick ONE way to connect ───────────────────────────
#
# Option A — File (good for teams): copy this file to `.env.local`, uncomment and fill:
#   VITE_SUPABASE_URL=https://xxxx.supabase.co
#   VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
#   Then restart: npm run dev
#
# Option B — Login screen: open the app → "Connect Supabase (optional)" → paste URL + anon key
#   (saves in this browser only; env vars override if both are set)
#
# Use the anon public key from Supabase → Settings → API. Never put the service_role key in the app.
#
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# If the dashboard only shows a publishable key (sb_publishable_…), you can use:
# VITE_SUPABASE_PUBLISHABLE_KEY=

# When true, sync app data (JSON bundle) to Supabase table `finance_os_app_bundle` after login.
# Run the `finance_os_app_bundle` section in `supabase/schema.sql` first. Do not enable with VITE_USE_LOCAL_DB
# if you want a single source (Supabase wins over local SQLite when both are set only if you turn local off).
# VITE_USE_SUPABASE_DATA=false

# ── AI Classification Configuration ───────────────────────────────────────────
# Default AI provider settings (can be overridden per organization in database)
# These are SERVER-SIDE ONLY - never prefix with VITE_ or they'll be exposed to clients
#
# IMPORTANT: Add your AI API key here for the classification feature to work
# Get your key from:
#   - OpenAI: https://platform.openai.com/api-keys
#   - Anthropic: https://console.anthropic.com/
#   - Google: https://makersuite.google.com/app/apikey
#
# AI_API_KEY=sk-...your-api-key-here...
# AI_PROVIDER_NAME=OpenAI
# AI_MODEL_NAME=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
#
# Encryption key for storing API keys in database (generate with: openssl rand -hex 32)
# REQUIRED in production for security
# AI_CONFIG_ENCRYPTION_KEY=your-64-character-hex-key-here

# ── Server-side auth config (server/config/env.ts) ──────────────────────────
# These are read by the Express API (server/), NOT by Vite/the browser — do not add a VITE_
# prefix to any of them, or they'd ship to every client.
#
# JWT_SECRET / JWT_EXPIRES_IN were REMOVED along with the local JWT flow
# (server/lib/jwt.ts + server/lib/passwords.ts). The server no longer signs or verifies tokens:
# sessions are issued and verified solely by Supabase Auth, and the server validates them with
# `sb.auth.getUser(accessToken)`. Token lifetime is governed by your Supabase project's auth
# settings, not by this server. Leave these out of .env entirely.
#
# Origin allowed to call the API. Must be an exact match, not a wildcard.
CORS_ORIGIN=http://localhost:5173

# Only used to CLEAR the retired `finance_os_session` cookie on logout, so a stale local JWT can't
# linger in an existing browser. Auth itself is header-based (`Authorization: Bearer`), so these
# are safe to leave at their defaults.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── AI Classification Configuration ────────────────────────────────────────
# These are used by the server for AI-powered transaction categorization.
# Per-organization config in database takes precedence if set.
# See docs/AI_CLASSIFICATION_SETUP.md for full documentation.

# AI_API_KEY=sk-your-api-key-here
# AI_PROVIDER=openai                 # openai, anthropic, gemini, azure_openai, custom
# AI_MODEL_NAME=gpt-4o-mini          # Model to use for classification
# AI_BASE_URL=                       # Optional: custom endpoint for OpenAI-compatible APIs
# AI_TEMPERATURE=0.3                 # 0-2, lower = more deterministic
# AI_MAX_TOKENS=500                  # Max tokens per response
